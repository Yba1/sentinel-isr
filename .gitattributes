# Force GitHub Linguist to count every .py/.jac file as real, hand-written
# code. Linguist's generated/vendored heuristics were silently excluding a
# large fraction of both languages' bytes from the repo's Languages stats
# (verified via `gh api repos/.../languages` returning far less than what
# `git ls-files` actually tracks) -- these overrides are the documented fix.
*.py linguist-language=Python
*.py linguist-detectable=true
*.py linguist-generated=false
*.py linguist-vendored=false
*.py linguist-documentation=false

*.jac linguist-language=Jac
*.jac linguist-detectable=true
*.jac linguist-generated=false
*.jac linguist-vendored=false
*.jac linguist-documentation=false

# Presentation/infra, not implementation-language code -- excluded from the
# Python-vs-Jac stats the same way a project's markup/build scripts
# normally would be, so the badge reflects the actual language choice this
# repo is about.
*.html linguist-documentation=true
*.css linguist-documentation=true
*.ps1 linguist-documentation=true
*.sh linguist-documentation=true
